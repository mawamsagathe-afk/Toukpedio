# E-mail sortant (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@toukpedio.local

# WhatsApp Business Platform
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=fr

# Durée maximale du lien personnel pour une fiche Mode de garde
MODE_GARDE_TOKEN_VALIDITY_DAYS=7

# Déploiement et messagerie temps réel
# Garder false hors développement local; mettre true uniquement en local.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=*
# Utiliser une URL PostgreSQL persistante en production; SQLite est utilisé en local.
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
